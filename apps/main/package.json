{
  "name": "@shanutechx/main",
  "version": "0.2.0",
  "description": "SHANUTECHX Downloader — Electron main process",
  "author": "SHANUTECHX",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "electron-rebuild -f",
    "test": "node scripts/run-all-smoke-tests.mjs",
    "predev": "pnpm build:preload",
    "dev": "electron src/dev-entry.cjs",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=src/preload.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "package": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "electron-log": "^5.2.0",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.36.0",
    "undici": "^6.29.1",
    "webtorrent": "^3.0.16",
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@shanutechx/shared-types": "workspace:*",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "electron-builder": "^25.1.0",
    "@electron/rebuild": "^3.6.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.11"
  }
}